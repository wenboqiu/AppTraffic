{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "composite": false, "noEmit": true
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*"
  ]
}
