{
  "name": "app-traffic",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "AppTraffic — 按应用统计上网流量，区分直连、代理与 VPN",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "tauri": "tauri",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "dist": "npm run build:native && tauri build --bundles nsis && node scripts/collect-dist.mjs",
    "dist:mac": "tauri build --target universal-apple-darwin --bundles app,dmg && node scripts/collect-dist.mjs"
  },
  "allowScripts": { "esbuild@0.21.5": true },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.1"
  }
}
