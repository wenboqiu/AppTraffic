{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AppTraffic",
  "version": "2.0.0",
  "identifier": "me.xueshi.apptraffic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1431",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "shortDescription": "按应用统计上网流量，区分直连、代理与 VPN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../native/target/release/traffic-etw.exe": "traffic-etw.exe",
      "../resources/etw-task.ps1": "etw-task.ps1"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
